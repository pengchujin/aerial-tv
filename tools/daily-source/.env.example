# Absolute path to the photo folder on the Docker host.
# Required. JPEG/JPEG only; landscape photos at least 1920 px wide are used.
PHOTOS_PATH=/path/to/photos

# Port the TV will connect to. Use the same value in Aerial's Daily Source settings.
AERIAL_PORT=8899

# Optional shared secret. Leave empty to allow requests without the header.
# Generate one with: openssl rand -hex 16
AERIAL_TOKEN=

# Time zone of the container and the hour (0-23) at which a new photo is picked.
TZ=Asia/Shanghai
GEN_HOUR=4

# Days of daily photos to keep (Aerial downloads the whole list, newest first).
DAYS=8

# Also write a *_UHD.jpg for TVs whose UI is drawn above 1080p.
UHD=1

# Caption shown by Aerial.
ALBUM_TITLE=Local album
ALBUM_COPYRIGHT=From local album
